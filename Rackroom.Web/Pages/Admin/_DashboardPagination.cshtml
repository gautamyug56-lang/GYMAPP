@model Rackroom.Web.Pages.Admin.DashboardPaginationModel

@if (Model.PageCount > 1)
{
    <nav aria-label="Dashboard pagination">
        <ul class="pagination pagination-sm mb-0">
            @for (int pageNumber = 1; pageNumber <= Model.PageCount; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-page="./Dashboard"
                       href="@(Model.QueryParameter == "expiringPage" ? $"?expiringPage={pageNumber}" : Model.QueryParameter == "paymentDeadlinePage" ? $"?paymentDeadlinePage={page}" : $"?attendancePage={page}")">
                        @pageNumber
                    </a>
                </li>
            }
        </ul>
    </nav>
}
