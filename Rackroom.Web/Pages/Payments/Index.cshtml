@page
@model Rackroom.Web.Pages.Payments.IndexModel
@{
    ViewData["Title"] = "Payments";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">Payments</h1>
            <p class="text-muted mb-0">Record membership payments and download invoices.</p>
        </div>
        <a asp-page="./Create" class="btn btn-primary">Record Payment</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Member</th>
                    <th>Membership</th>
                    <th>Method</th>
                    <th>Amount</th>
                    <th>Invoice</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var payment in Model.Payments)
            {
                <tr>
                    <td>@payment.PaidAtUtc.ToString("yyyy-MM-dd")</td>
                    <td>@payment.Member?.FirstName @payment.Member?.LastName</td>
                    <td>@payment.Membership?.MembershipPlan?.Name</td>
                    <td>@payment.Method</td>
                    <td>NPR @payment.Amount.ToString("N2")</td>
                    <td>
                        @if (payment.Invoice is not null)
                        {
                            <a asp-page="./Invoice"
                               asp-route-invoiceNumber="@payment.Invoice.InvoiceNumber"
                               class="btn btn-sm btn-outline-primary">
                                Download #@payment.Invoice.InvoiceNumber
                            </a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (Model.Payments.Count == 0)
    {
        <div class="alert alert-info">No payments have been recorded yet.</div>
    }
</div>
