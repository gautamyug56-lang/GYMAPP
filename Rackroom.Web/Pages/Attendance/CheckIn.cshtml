@page
@model Rackroom.Web.Pages.Attendance.CheckInModel
@{
    ViewData["Title"] = "Check In";
}

<div class="container py-5">
    <div class="card shadow-sm mx-auto text-center" style="max-width: 520px;">
        <div class="card-body p-4">
            @if (Model.CheckedIn)
            {
                <div class="display-5 mb-3">✓</div>
                <h1 class="h3">Check-in successful</h1>
                <p class="text-muted">Your attendance has been recorded for @DateTime.Now.ToString("HH:mm").</p>
                <a asp-page="/Attendance/Index" class="btn btn-primary">View Attendance</a>
            }
            else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <h1 class="h3">Check-in unavailable</h1>
                <div class="alert alert-warning mt-3">@Model.ErrorMessage</div>
                <a asp-page="/Attendance/Index" class="btn btn-outline-primary">Back to Attendance</a>
            }
            else
            {
                <h1 class="h3">Confirm check-in</h1>
                <p class="text-muted">
                    You are checking in using the current Rackroom gym desk QR code.
                </p>

                <form method="post">
                    <input type="hidden" asp-for="Token" />
                    <button type="submit" class="btn btn-primary btn-lg">Check In Now</button>
                </form>
            }
        </div>
    </div>
</div>
