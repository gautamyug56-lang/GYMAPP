@page "{id:guid}"
@model Rackroom.Web.Pages.Memberships.PauseModel
@{
    ViewData["Title"] = "Request Membership Pause";
}

<div class="container py-4">
    <h1 class="h3">Request Membership Pause</h1>

    <p class="text-muted">
        @Model.Membership?.Member?.FirstName @Model.Membership?.Member?.LastName —
        @Model.Membership?.MembershipPlan?.Name
    </p>

    <form method="post" class="mt-3" style="max-width: 600px;">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Input.StartDateUtc" class="form-label">Pause start</label>
            <input asp-for="Input.StartDateUtc" class="form-control" type="date" />
        </div>

        <div class="mb-3">
            <label asp-for="Input.EndDateUtc" class="form-label">Pause end</label>
            <input asp-for="Input.EndDateUtc" class="form-control" type="date" />
        </div>

        <div class="mb-3">
            <label asp-for="Input.Reason" class="form-label">Reason</label>
            <textarea asp-for="Input.Reason" class="form-control" rows="3"></textarea>
        </div>

        <div class="alert alert-warning">
            Maximum pause: 30 days. Maximum approved pauses: 2 per calendar year.
            A staff member must approve the request.
        </div>

        <button type="submit" class="btn btn-primary">Request Pause</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
