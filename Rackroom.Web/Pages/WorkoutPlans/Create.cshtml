@page
@model Rackroom.Web.Pages.WorkoutPlans.CreateModel
<div class="container py-4"><div class="card shadow-sm"><div class="card-body"><h1 class="h4">Create workout plan</h1>
@if(Model.Error is not null){<div class="alert alert-danger">@Model.Error</div>}
<form method="post"><div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required/></div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control"></textarea></div>
<div class="mb-3"><label asp-for="PlanJson" class="form-label">Plan JSON</label><textarea asp-for="PlanJson" rows="8" class="form-control font-monospace" required></textarea></div>
<button class="btn btn-primary">Save</button></form></div></div></div>
