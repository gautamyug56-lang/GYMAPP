@page
@model Rackroom.Web.Pages.WorkoutPlans.AssignModel
<div class="container py-4"><div class="card shadow-sm"><div class="card-body"><h1 class="h4">Assign workout plan</h1>
@if(Model.Error is not null){<div class="alert alert-danger">@Model.Error</div>}
<form method="post"><input type="hidden" asp-for="TemplateId"/><div class="mb-3"><label asp-for="MemberId" class="form-label">Member</label><select asp-for="MemberId" class="form-select" required><option value="">Select member</option>@foreach(var m in Model.Members){<option value="@m.Id">@m.FirstName @m.LastName — @m.Email</option>}</select></div><button class="btn btn-primary">Assign</button></form>
</div></div></div>
