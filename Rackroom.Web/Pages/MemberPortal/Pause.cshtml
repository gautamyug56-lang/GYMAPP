@page
@model Rackroom.Web.Pages.MemberPortal.PauseModel
<div class="container py-4"><div class="card shadow-sm"><div class="card-body">
<h1 class="h4">Request membership pause</h1>
@if(Model.Error is not null){<div class="alert alert-danger">@Model.Error</div>}
<form method="post">
<input type="hidden" asp-for="MembershipId"/>
<div class="mb-3"><label asp-for="StartDate" class="form-label">Start</label><input asp-for="StartDate" type="date" class="form-control" required/></div>
<div class="mb-3"><label asp-for="EndDate" class="form-label">End</label><input asp-for="EndDate" type="date" class="form-control" required/></div>
<div class="mb-3"><label asp-for="Reason" class="form-label">Reason</label><textarea asp-for="Reason" class="form-control"></textarea></div>
<button class="btn btn-primary">Submit request</button> <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form></div></div></div>
